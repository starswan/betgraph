<% content_for :title do %>
  League Table <%= division.name %> for Season <%= season.name %>
<% end %>
<% content_for :menu do -%>
  <%= render "layouts/shared/menu_item", href: football_division_path(division), text: 'Division' %>
  <%= render "layouts/shared/menu_item", href: football_seasons_path, text: 'Seasons' %>
  <% seasons.order(:startdate).reject { |s| s == season }.reverse_each do |s| -%>
    <%= render "layouts/shared/menu_item", href: football_season_division_tables_path(s, division), text: s.name %>
  <% end -%>
<% end -%>
<div align="center"><b><%= yield :title %></b></div>
