<% content_for :title do %>
  League Table <%= division.name %> for Season <%= season.name %>
<% end %>
<% content_for :menu do -%>
  <%= render "layouts/shared/menu_item", href: division_path(division), text: 'Division' %>
  <%= render "layouts/shared/menu_item", href: sport_seasons_path(division.sport), text: 'Seasons' %>
<!--  <li class="nav-item">-->
    <%#= link_to 'Division', division_path(division), class: 'nav-link' %>
<!--  </li>-->
<!--  <li class="nav-item">-->
    <%#= link_to 'Seasons', sport_seasons_path(division.sport), class: 'nav-link' %>
<!--  </li>-->
  <% seasons.order(:startdate).reject { |s| s == season }.reverse_each do |s| -%>
<!--    <li class="nav-item">-->
      <%#= link_to_unless season == s, s.name, division_season_tables_path(division, s), class: 'nav-link' %>
<!--    </li>-->
    <%= render "layouts/shared/menu_item", href: division_season_tables_path(division, s), text: s.name %>
  <% end -%>
<% end -%>
<div align="center"><b><%= yield :title %></b></div>
