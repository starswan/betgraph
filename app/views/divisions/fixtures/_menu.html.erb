<% content_for :title do %>
  <%= season.name %> <%= division.name %> Fixtures on <%= date.to_fs(:short) %>
<% end %>
<% content_for :menu do -%>
  <%= render "layouts/shared/menu_item", href: division_path(division), text: 'Division' %>
  <% seasons.reject { |s| season == s }.reverse_each do |s| -%>
    <%= render "layouts/shared/menu_item",
               href: sport_season_division_fixtures_path(division.sport, s, division),
               text: "#{s.name}(#{s.matches.where(division: division).with_prices.count})"
    %>
  <% end -%>
  <% divisions.each do |d| %>
    <%= render "layouts/shared/menu_item",
               href: sport_season_division_fixture_path(d.sport, season, d, date),
               text:  d.name
    %>
  <% end %>
<% end -%>
<div align="center"><b><%= yield :title %></b></div>
