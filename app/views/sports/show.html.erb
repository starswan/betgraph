<!-- sports/$Id$ -->
<% content_for :menu do %>
  <%= render 'layouts/shared/active_future_links' %>
  <%= render "layouts/shared/menu_item", href: sport_betfair_market_types_path(@sport), text: 'Market Types' %>
  <%= render "layouts/shared/menu_item", href: sport_basket_rules_path(@sport), text: 'Basket Rules' %>
  <%= render "layouts/shared/menu_item", href: sport_divisions_path(@sport), text: 'Divisions' %>
  <%= render "layouts/shared/menu_item", href: sport_teams_path(@sport), text: 'Teams' %>
  <%= render "layouts/shared/menu_item", href: sport_matches_path(@sport), text: 'Matches' %>
<% end %>
<div class="page-header">
  <b><%= @sport.name %>&nbsp;(<%= @sport.betfair_sports_id %>)</b>
</div>
<table class="table table-responsive table-striped">
  <% @sport.divisions.active.each do |division| %>
    <tr>
      <td><%= link_to division.name, division %></td>
    </tr>
  <% end %>
</table>
<%#- model_class = Sport -%>

