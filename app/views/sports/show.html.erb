<!-- sports/$Id$ -->
<% content_for :menu do %>
  <%= render 'layouts/shared/active_future_links' %>
  <nord-nav-item href="<%= sport_betfair_market_types_path(@sport) %>">
    Market Types
  </nord-nav-item>
  <nord-nav-item href="<%= sport_basket_rules_path(@sport) %>">
    Basket Rules
  </nord-nav-item>
  <nord-nav-item href="<%= sport_divisions_path(@sport) %>">
    Divisions
  </nord-nav-item>
  <nord-nav-item href="<%= sport_teams_path(@sport) %>">
    Teams
  </nord-nav-item>
  <nord-nav-item href="<%= sport_matches_path(@sport) %>">
    Matches
  </nord-nav-item>
<% end %>
<div class="page-header">
  <b><%= @sport.name %>&nbsp;(<%= @sport.betfair_sports_id %>)</b>
</div>
<table class="table table-responsive table-striped">
  <% @sport.divisions.active.each do |division| %>
    <tr>
      <td><%= link_to division.name, division %></td>
    </tr>
  <% end %>
</table>
<%#- model_class = Sport -%>

